# =============================================================
# NEXORA AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_me_use_at_least_64_random_chars
JWT_EXPIRY=8h
SESSION_SECRET=change_me_session_secret

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
DATABASE_URL=postgresql://nexora:nexora_pass@localhost:5432/nexora_ai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_ai
DB_USER=nexora
DB_PASSWORD=nexora_pass

# ── Redis (session / queue) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Mapbox (optional — falls back to OpenStreetMap/Leaflet) ──
# MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── Weather API (optional — mock data if not set) ────────────
# WEATHER_API_PROVIDER=openweathermap
# WEATHER_API_KEY=your_openweathermap_api_key
# WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ── Email (optional — logs to console if not set) ────────────
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=noreply@nexora-ai.in

# ── SMS (optional — logs to console if not set) ──────────────
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# ── File Storage (optional — local disk if not set) ──────────
# STORAGE_PROVIDER=ibm_cos
# IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
# IBM_COS_API_KEY=your_ibm_cos_api_key
# IBM_COS_BUCKET=nexora-uploads
# IBM_COS_SERVICE_INSTANCE_ID=your_crn

# ── AI / Analytics (optional — rule-based engine if not set) ─
# AI_PROVIDER=watsonx
# WATSONX_API_KEY=your_watsonx_api_key
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=your_project_id
# ANALYTICS_SERVICE_URL=http://localhost:5000

# ── 2FA ──────────────────────────────────────────────────────
TOTP_ISSUER=NEXORA_AI

# ── Misc ─────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,application/pdf
